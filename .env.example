LLM_PROVIDER=gemini           # gemini | anthropic
GEMINI_API_KEY=               # required when LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=            # required when LLM_PROVIDER=anthropic
GEN_MODEL=gemini-3.8-flash    # anthropic: claude-sonnet-5-5
JUDGE_MODEL=gemini-3.5-flash-lite  # anthropic: claude-haiku-5-5
LLM_RPM=10                    # client-side cap per model (Gemini free tier); check AI Studio
LLM_MAX_RETRIES=5             # retries for 429 / overloaded, with backoff
LLM_MAX_BACKOFF_S=60          # a longer server retry delay = quota exhausted, fail now
LLM_TIMEOUT_S=60              # per request; a hung call counts as a transient error
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite  # used once when GEN_MODEL is still overloaded after retries; "none" disables

TARGET_DB_URL=postgresql://sqlguard_reader:reader_pw@localhost:5432/pagila
ADMIN_DB_URL=postgresql://postgres:postgres@localhost:5432/pagila     # setup scripts only, never the app
APP_DB_URL=postgresql://sqlguard_app:app_pw@localhost:5432/sqlguard_app

DEFAULT_LIMIT=100
MAX_LIMIT=1000
STATEMENT_TIMEOUT_MS=5000
MAX_COST=100000
MAX_PLAN_ROWS=1000000
MAX_REPAIRS=2
SELF_CONSISTENCY_N=2          # gemini free tier: 2 (anthropic default: 3)
CONFIDENCE_THRESHOLD=0.7
CONFIDENCE_HIGH=0.85          # UI badge HIGH cutoff
MAX_QUESTION_CHARS=1000
REFERENCE_DATE=2026-07-29     # "today" for relative dates = day after max(payment_date) in pinned Pagila
SCORE_WEIGHT_JUDGE=0.45       # SCORING weights (STATE.md §4); must be >= 0 and sum to 1
SCORE_WEIGHT_CONSISTENCY=0.25
SCORE_WEIGHT_REPAIRS=0.15
SCORE_WEIGHT_SANITY=0.15
